@@ -664,6 +664,28 @@
                 'notify the console-client developers. Send them a set of command-line arguments and the request data:\n%s') % DATA )
             exit(1)
 
+    # A task can be canceled as long as it is still in flight. final_statuses are
+    # the states from which nothing more can happen, so cancelling those is refused.
+    # 10000 (build is canceling) is excluded separately so that a task which is
+    # already on its way out is not canceled twice.
+    def is_cancellable(self):
+        return self.status not in self.final_statuses and self.status != 10000
+
+    def cancel(self):
+        try:
+            log.info(_("Canceling the task %s...") % self.id)
+            result = self.models.jsn.cancel(self.id)
+            if result['build_list']['message'] == 'Build canceled':
+                log.info(result['build_list']['message'])
+            else:
+                log.error(result['build_list']['message'])
+
+            return result
+        except BadRequestError as ex:
+            log.error(_('Sorry, but something went wrong and request I\'ve sent to ABF is bad. Please, '
+                'notify the console-client developers. Send them a set of command-line arguments and the request data:\n%s') % DATA )
+            exit(1)
+
 
